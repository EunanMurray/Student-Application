@model StudentApplicationPages.ViewModels.ApplicantViewModel
@{
    var campusSelectList = ViewData["CampusSelectList"] as SelectList;
}

<div class="container">
    <h3>Academic History and Campus Choices</h3>

    <div class="form-group">
        <label asp-for="SecondarySchoolAttended" class="control-label"></label>
        <input asp-for="SecondarySchoolAttended" class="form-control" />
        <span asp-validation-for="SecondarySchoolAttended" class="text-danger"></span>
    </div>

    <div class="form-group">
        <div class="form-check">
            <input asp-for="PriorThirdLevelAttendance" class="form-check-input" type="checkbox" />
            <label asp-for="PriorThirdLevelAttendance" class="form-check-label"></label>
        </div>
    </div>

    <div class="form-group">
        <label class="control-label">ATU Student Information (Optional)</label>
        <p class="text-muted">If you are currently a student in ATU, please input your Student Number and Course Year</p>

        <div class="row">
            <div class="col-md-6">
                <label asp-for="StudentNumber" class="control-label">Student Number</label>
                <input asp-for="StudentNumber" class="form-control" placeholder="Enter your student number" />
                <span asp-validation-for="StudentNumber" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CollegeYear" class="control-label">College Year</label>
                <select asp-for="CollegeYear" class="form-control">
                    <option value="">Select College Year</option>
                    <option value="1">1st Year</option>
                    <option value="2">2nd Year</option>
                    <option value="3">3rd Year</option>
                    <option value="4">4th Year</option>
                </select>
                <span asp-validation-for="CollegeYear" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="CAONumber" class="control-label"></label>
        <input asp-for="CAONumber" class="form-control" />
        <span asp-validation-for="CAONumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CampusID" class="control-label">Campus Selection</label>
        <select asp-for="CampusID" asp-items="campusSelectList" class="form-control">
            <option value="">Select Campus</option>
        </select>
        <span asp-validation-for="CampusID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CourseSelectionReasons" class="control-label"></label>
        <textarea asp-for="CourseSelectionReasons" class="form-control" rows="4"></textarea>
        <span asp-validation-for="CourseSelectionReasons" class="text-danger"></span>
    </div>
</div>

@section Scripts {
    <script>
        function addCourseCode() {
            var container = document.getElementById('courseCodesContainer');
            var input = document.createElement('input');
            input.name = "CourseCodes";
            input.type = "text";
            input.classList.add("form-control");
            container.appendChild(input);
        }
    </script>
}
