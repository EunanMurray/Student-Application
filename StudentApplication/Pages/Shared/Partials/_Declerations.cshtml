@model StudentApplicationPages.ViewModels.ApplicantViewModel

<div class="container">
    <h3 class="text-center">Sports Scholar Leisurewear and Declaration</h3>
    <div class="form-group">
        <label asp-for="PreferredLeisurewearSize" class="control-label">Preferred Leisurewear Size</label>
        <select asp-for="PreferredLeisurewearSize" class="form-control">
            <option value="">Select Size</option>
            <option value="XSmall">XSmall</option>
            <option value="Small">Small</option>
            <option value="Medium">Medium</option>
            <option value="Large">Large</option>
            <option value="XLarge">XLarge</option>
            <!-- Add other sizes if needed -->
        </select>
        <span asp-validation-for="PreferredLeisurewearSize" class="text-danger"></span>
    </div>
    <div class="form-group">
        <div class="form-check">
            <input asp-for="IsDeclarationConfirmed" type="checkbox" class="form-check-input" />
            <label asp-for="IsDeclarationConfirmed" class="form-check-label">I confirm the declaration</label>
        </div>
        <span asp-validation-for="IsDeclarationConfirmed" class="text-danger"></span>
    </div>
</div>
