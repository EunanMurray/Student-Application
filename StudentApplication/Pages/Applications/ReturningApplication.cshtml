@page
@model StudentApplication.Pages.Applications.ReturningApplicationModel
@{
    ViewData["Title"] = "Scholarship Renewal Application";
}

<div class="container py-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="alert alert-info">
        <h4>Welcome Back, @Model.Application.FirstName!</h4>
        <p>As a returning scholarship recipient, your application process is simplified. We've pre-filled information from your previous application to make this easier.</p>
        <p>Please focus on updating your achievements and goals from the past academic year.</p>
    </div>

    @if (Model.ErrorMessages.Any())
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in Model.ErrorMessages)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <form method="post" id="renewalForm" class="needs-validation">
        @Html.AntiForgeryToken()

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Personal Information</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Application.FirstName" class="form-label">First Name</label>
                            <input asp-for="Application.FirstName" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Application.LastName" class="form-label">Last Name</label>
                            <input asp-for="Application.LastName" class="form-control" readonly />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Application.Email" class="form-label">Email</label>
                            <input asp-for="Application.Email" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Application.MobilePhoneNumber" class="form-label">Mobile Phone</label>
                            <input asp-for="Application.MobilePhoneNumber" class="form-control" />
                            <span asp-validation-for="Application.MobilePhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Application.Address" class="form-label">Current Address</label>
                    <input asp-for="Application.Address" class="form-control" />
                    <span asp-validation-for="Application.Address" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Academic Information</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Application.CurrentYear" class="form-label">Current Academic Year</label>
                            <input asp-for="Application.CurrentYear" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Application.CurrentGPA" class="form-label">Current GPA</label>
                            <input asp-for="Application.CurrentGPA" class="form-control" required />
                            <span asp-validation-for="Application.CurrentGPA" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Athletic Achievements</h4>
            </div>
            <div class="card-body">
                <div class="form-group mb-3">
                    <label asp-for="Application.AcademicYearAchievements" class="form-label">Achievements during the past academic year</label>
                    <textarea asp-for="Application.AcademicYearAchievements" class="form-control" rows="5" required></textarea>
                    <span asp-validation-for="Application.AcademicYearAchievements" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Application.AthleteOfYearNomination" class="form-label">Were you nominated for Athlete of the Year?</label>
                    <select asp-for="Application.AthleteOfYearNomination" class="form-select">
                        <option value="">Select an option</option>
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Application.ATURepresentation" class="form-label">How have you represented ATU in competitions?</label>
                    <textarea asp-for="Application.ATURepresentation" class="form-control" rows="3" required></textarea>
                    <span asp-validation-for="Application.ATURepresentation" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Application.CurrentSportingGoals" class="form-label">Current sporting goals</label>
                    <textarea asp-for="Application.CurrentSportingGoals" class="form-control" rows="3" required></textarea>
                    <span asp-validation-for="Application.CurrentSportingGoals" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Declaration</h4>
            </div>
            <div class="card-body">
                <div class="form-check mb-3">
                    <input asp-for="Application.IsDeclarationConfirmed" class="form-check-input" type="checkbox" required />
                    <label asp-for="Application.IsDeclarationConfirmed" class="form-check-label">
                        I confirm that all information provided is accurate and I have maintained the academic and athletic standards required for my scholarship renewal.
                    </label>
                    <span asp-validation-for="Application.IsDeclarationConfirmed" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg">Submit Renewal Application</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}