@page
@model StudentApplicationPages.Pages.Applications.ApplyModel
@using StudentApplicationPages.ViewModels
@{
    ViewData["Title"] = "Scholarship Application";
}

<style>
    .progress-bar-container {
        margin-bottom: 20px;
    }

    .tab {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
    }

    .tablinks {
        flex: 1;
        min-width: 150px;
        padding: 10px;
        border: none;
        background-color: #f8f9fa;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .tablinks.active {
            background-color: #007bff;
            color: white;
        }

        .tablinks:hover {
            background-color: #e9ecef;
        }

        .tablinks.active:hover {
            background-color: #0056b3;
        }

    .loading-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    .loading-spinner {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .input-validation-error {
        border-color: #dc3545;
    }
</style>

<div class="container">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="progress-bar-container">
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: 0%"></div>
        </div>
    </div>

    @if (Model.ErrorMessages.Any())
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            <ul class="mb-0">
                @foreach (var error in Model.ErrorMessages)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-border text-light" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    </div>

    <form method="post" id="applicationForm" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()

        <!-- Tab Buttons -->
        <div class="tab">
            <button type="button" class="tablinks btn btn-light" onclick="openTab(event, 'PersonalDetails')" id="defaultTab">
                <i class="fas fa-user"></i> Personal Details
            </button>
            <button type="button" class="tablinks btn btn-light" onclick="openTab(event, 'AcademicHistory')">
                <i class="fas fa-graduation-cap"></i> Academic History
            </button>
            <button type="button" class="tablinks btn btn-light" onclick="openTab(event, 'SportDetails')">
                <i class="fas fa-running"></i> Sport Details
            </button>
            <button type="button" class="tablinks btn btn-light" onclick="openTab(event, 'References')">
                <i class="fas fa-users"></i> References
            </button>
            <button type="button" class="tablinks btn btn-light" onclick="openTab(event, 'Declarations')">
                <i class="fas fa-check-circle"></i> Declarations
            </button>
            <button type="button" class="tablinks btn btn-light" onclick="openTab(event, 'Review')">
                <i class="fas fa-eye"></i> Review & Submit
            </button>
        </div>

        <!-- Tab Content -->
        <div id="PersonalDetails" class="tabcontent">
            @await Html.PartialAsync("~/Pages/Shared/Partials/_PersonalDetails.cshtml", Model.Application)
        </div>

        <div id="AcademicHistory" class="tabcontent">
            @await Html.PartialAsync("~/Pages/Shared/Partials/_AcademicHistory.cshtml", Model.Application,
                     new ViewDataDictionary(ViewData) { { "CampusSelectList", Model.CampusSelectList } })
        </div>

        <div id="SportDetails" class="tabcontent">
            @await Html.PartialAsync("~/Pages/Shared/Partials/_SportDetails.cshtml", Model.Application,
                     new ViewDataDictionary(ViewData) { { "SportSelectList", Model.SportSelectList } })
        </div>

        <div id="References" class="tabcontent">
            @await Html.PartialAsync("~/Pages/Shared/Partials/_References.cshtml", Model.Application)
        </div>

        <div id="Declarations" class="tabcontent">
            @await Html.PartialAsync("~/Pages/Shared/Partials/_Declerations.cshtml", Model.Application)
        </div>

        <div id="Review" class="tabcontent">
            @await Html.PartialAsync("~/Pages/Shared/Partials/_Review.cshtml", Model.Application)
        </div>

        <!-- Navigation Buttons -->
        <div class="navigation-buttons d-flex justify-content-between mt-4">
            <button type="button" id="prevBtn" onclick="nextPrev(-1)" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Previous
            </button>
            <button type="button" id="nextBtn" onclick="nextPrev(1)" class="btn btn-primary">
                Next <i class="fas fa-arrow-right"></i>
            </button>
            <button type="submit" id="submitBtn" style="display:none" class="btn btn-success" name="submit" value="submit">
                <i class="fas fa-check"></i> Submit Application
            </button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://kit.fontawesome.com/your-kit-code.js" crossorigin="anonymous"></script>

    <script>
        let formData = {};

        function updateFormData() {
            const form = document.getElementById('applicationForm');
            const formElements = form.elements;

            for (let element of formElements) {
                if (element.name) {
                    if (element.type === 'checkbox') {
                        formData[element.name] = element.checked;
                    } else if (element.type === 'select-multiple') {
                        formData[element.name] = Array.from(element.selectedOptions).map(option => option.value);
                    } else {
                        formData[element.name] = element.value;
                    }
                }
            }
        }

        function updateReviewField(fieldName, value) {
            const element = document.querySelector(`[data-review-field="${fieldName}"]`);
            if (element) {
                element.textContent = value || '';
            }
        }

        function updateReviewTab() {
            updateFormData();

            updateReviewField('Name', formData['Name']);
            updateReviewField('Email', formData['Email']);
            updateReviewField('Gender', formData['Gender']);
            updateReviewField('DateOfBirth', formData['DateOfBirth']);
            updateReviewField('MobilePhoneNumber', formData['MobilePhoneNumber']);
            updateReviewField('Address', formData['Address']);

            const parentEmail = formData['ParentEmail'] || formData['Applicant.ParentEmail'];
            const parentPhone = formData['ParentPhoneNumber'] || formData['Applicant.ParentPhoneNumber'];
            updateReviewField('ParentEmail', formData['ParentEmail']);
            updateReviewField('ParentPhoneNumber', formData['ParentPhoneNumber']);
            updateReviewField('SecondarySchoolAttended', formData['SecondarySchoolAttended']);
            updateReviewField('PriorThirdLevelAttendance', formData['PriorThirdLevelAttendance'] ? 'Yes' : 'No');
            updateReviewField('CAONumber', formData['CAONumber']);

            const campusSelect = document.querySelector('select[name="CampusID"]');
            if (campusSelect && formData['CampusID']) {
                const selectedOption = campusSelect.options[campusSelect.selectedIndex];
                updateReviewField('Campus', selectedOption ? selectedOption.text : '');
            }

            const courseCodes = Array.from(document.getElementsByName('CourseCodes'))
                .map(input => input.value)
                .filter(value => value);
            updateReviewField('Course Codes', courseCodes.join(', '));

            const sportSelect = document.querySelector('select[name="SportIDs"]');
            if (sportSelect) {
                const selectedSports = Array.from(sportSelect.selectedOptions).map(option => option.text);
                updateReviewField('Main Sports', selectedSports.join(', '));
            }

            updateReviewField('SportPositionOrCategory', formData['SportPositionOrCategory']);
            updateReviewField('CurrentClub', formData['CurrentClub']);
            updateReviewField('PastClubs', formData['PastClubs']);
            updateReviewField('HighestCompetitionLevel', formData['HighestCompetitionLevel']);
            updateReviewField('SportingAchievements', formData['SportingAchievements']);
            updateReviewField('SportingGoals', formData['SportingGoals']);
            updateReviewField('Referee1Name', formData['Referees[0].Name']);
            updateReviewField('Referee1Role', formData['Referees[0].TitleOrRole']);
            updateReviewField('Referee1Phone', formData['Referees[0].PhoneNumber']);
            updateReviewField('Referee1Email', formData['Referees[0].Email']);
            updateReviewField('Referee2Name', formData['Referees[1].Name']);
            updateReviewField('Referee2Role', formData['Referees[1].TitleOrRole']);
            updateReviewField('Referee2Phone', formData['Referees[1].PhoneNumber']);
            updateReviewField('Referee2Email', formData['Referees[1].Email']);
            updateReviewField('PreferredLeisurewearSize', formData['PreferredLeisurewearSize']);
            updateReviewField('Declaration Confirmed', formData['IsDeclarationConfirmed'] ? 'Yes' : 'No');
        }

        var currentTab = 0;
        showTab(currentTab);

        function updateProgress(currentTab) {
            var tabs = document.getElementsByClassName("tabcontent");
            var progress = (currentTab / (tabs.length - 1)) * 100;
            document.querySelector('.progress-bar').style.width = progress + '%';
        }

        function showTab(n) {
            var tabs = document.getElementsByClassName("tabcontent");
            for (var i = 0; i < tabs.length; i++) {
                tabs[i].style.display = "none";
            }
            tabs[n].style.display = "block";

            document.getElementById("prevBtn").style.display = (n == 0) ? "none" : "inline";
            if (n == (tabs.length - 1)) {
                document.getElementById("nextBtn").style.display = "none";
                document.getElementById("submitBtn").style.display = "inline";
            } else {
                document.getElementById("nextBtn").style.display = "inline";
                document.getElementById("submitBtn").style.display = "none";
            }

            updateProgress(n);
            updateTabButtons(n);

            if (tabs[n].id === 'Review') {
                updateReviewTab();
            }
        }

        function updateTabButtons(n) {
            var tablinks = document.getElementsByClassName("tablinks");
            for (var i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }
            tablinks[n].className += " active";
        }

        function validateTab(n) {
            var currentTab = document.getElementsByClassName("tabcontent")[n];
            var inputs = currentTab.querySelectorAll("input[required], select[required], textarea[required]");
            var isValid = true;

            inputs.forEach(function(input) {
                if (!input.value) {
                    isValid = false;
                    input.classList.add('input-validation-error');
                } else {
                    input.classList.remove('input-validation-error');
                }
            });

            return isValid;
        }

        function nextPrev(n) {
            var tabs = document.getElementsByClassName("tabcontent");

            if (n > 0 && !validateTab(currentTab)) {
                alert('Please fill in all required fields before proceeding.');
                return false;
            }

            tabs[currentTab].style.display = "none";
            currentTab = currentTab + n;

            if (currentTab >= tabs.length) {
                if (validateTab(tabs.length - 1)) {
                    document.getElementById("applicationForm").submit();
                }
                return false;
            }

            showTab(currentTab);
        }

        function openTab(evt, tabName) {
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }
            document.getElementById(tabName).style.display = "block";
            evt.currentTarget.className += " active";
            currentTab = Array.from(tabcontent).findIndex(tab => tab.id === tabName);

            if (tabName === 'Review') {
                updateReviewTab();
            }

            showTab(currentTab);
        }

        document.getElementById('applicationForm').addEventListener('change', function() {
            updateFormData();
        });

        document.getElementById("defaultTab").click();
    </script>
}