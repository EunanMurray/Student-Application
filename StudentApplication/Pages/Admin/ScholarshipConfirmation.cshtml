@page
@model StudentApplication.Pages.Applicants.ScholarshipConfirmationModel
@{
    ViewData["Title"] = "Scholarship Response Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h2 class="text-center mb-0">Response Confirmed</h2>
                </div>
                <div class="card-body text-center py-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="mb-4">
                            <i class="fas fa-check-circle fa-4x text-success"></i>
                        </div>
                        <h3>Congratulations!</h3>
                        <p class="lead">@TempData["SuccessMessage"]</p>
                        <p>Our team will contact you soon with next steps.</p>
                    }
                    else if (TempData["InfoMessage"] != null)
                    {
                        <div class="mb-4">
                            <i class="fas fa-info-circle fa-4x text-info"></i>
                        </div>
                        <h3>Thank You</h3>
                        <p class="lead">@TempData["InfoMessage"]</p>
                        <p>We appreciate your response. If you change your mind, please contact our scholarship office.</p>
                    }
                    else
                    {
                        <div class="mb-4">
                            <i class="fas fa-thumbs-up fa-4x text-primary"></i>
                        </div>
                        <h3>Thank You</h3>
                        <p class="lead">Your response has been recorded.</p>
                    }

                    <div class="mt-4">
                        <a href="/" class="btn btn-primary">Return to Home</a>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="text-center">
                        <p class="mb-0">Questions? Contact us at <a href="mailto:scholarships@example.edu">scholarships@example.edu</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>