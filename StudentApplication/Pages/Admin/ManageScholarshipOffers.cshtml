@page
@model StudentApplication.Pages.Admin.ManageScholarshipOffersModel
@{
    ViewData["Title"] = "Manage Scholarship Offers";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <a asp-page="/Admin/RoleTest" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to User Management
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model.ScholarshipOffers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Applicant</th>
                                <th>Sport</th>
                                <th>Scholarship Level</th>
                                <th>Offer Date</th>
                                <th>Status</th>
                                <th>Stage</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var offer in Model.ScholarshipOffers)
                            {
                                <tr>
                                    <td>@offer.ApplicantName</td>
                                    <td>@offer.SportName</td>
                                    <td>
                                        <span class="badge @(offer.ScholarshipLevel == "Gold" ? "bg-warning text-dark" :
                                                          offer.ScholarshipLevel == "Silver" ? "bg-secondary" :
                                                          offer.ScholarshipLevel == "Bronze" ? "bg-bronze text-white" : "bg-primary")">
                                            @offer.ScholarshipLevel
                                        </span>
                                    </td>
                                    <td>@offer.OfferDate.ToShortDateString()</td>
                                    <td>
                                        <span class="badge @(offer.ResponseStatus == "Accepted" ? "bg-success" :
                                                          offer.ResponseStatus == "Declined" ? "bg-danger" :
                                                          offer.ResponseStatus == "Pending" ? "bg-warning text-dark" : "bg-secondary")">
                                            @offer.ResponseStatus
                                        </span>
                                    </td>
                                    <td>@offer.Stage</td>
                                    <td>
                                        <form method="post" asp-page-handler="DeleteOffer" asp-route-offerId="@offer.OfferId"
                                              onsubmit="return confirm('Are you sure you want to delete this scholarship offer? This will reset the applicant\'s status to not reviewed and remove all associated scholarship data.');">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="fas fa-trash"></i> Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No scholarship offers found.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .bg-bronze {
        background-color: #cd7f32;
    }
</style>