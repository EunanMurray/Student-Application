@page
@model StudentApplication.Pages.Admin.AddUserModel
@{
    ViewData["Title"] = "Add New User";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h2 class="text-center mb-0">Add New User</h2>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                    }

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="UserInput.Email" class="form-label">Email</label>
                            <input asp-for="UserInput.Email" class="form-control" required />
                            <span asp-validation-for="UserInput.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserInput.Username" class="form-label">Username</label>
                            <input asp-for="UserInput.Username" class="form-control" required />
                            <span asp-validation-for="UserInput.Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserInput.Password" class="form-label">Password</label>
                            <input asp-for="UserInput.Password" type="password" class="form-control" required />
                            <span asp-validation-for="UserInput.Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserInput.ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="UserInput.ConfirmPassword" type="password" class="form-control" required />
                            <span asp-validation-for="UserInput.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserInput.Role" class="form-label">Role</label>
                            <select asp-for="UserInput.Role" class="form-select" required>
                                <option value="">Select a role</option>
                                <option value="Admin">Admin</option>
                                <option value="Secretary">Secretary</option>
                                <option value="Committee Member">Committee Member</option>
                            </select>
                            <span asp-validation-for="UserInput.Role" class="text-danger"></span>
                        </div>

                        <div class="mb-3" id="sportsSection" style="display: none;">
                            <label asp-for="UserInput.SelectedSports" class="form-label">Assigned Sports</label>
                            <select asp-for="UserInput.SelectedSports" asp-items="Model.SportsList" class="form-select" multiple>
                            </select>
                            <span asp-validation-for="UserInput.SelectedSports" class="text-danger"></span>
                            <small class="form-text text-muted">Hold Ctrl to select multiple sports</small>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary">Create User</button>
                            <a asp-page="/Admin/RoleTest" class="btn btn-secondary ms-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const roleSelect = document.querySelector('[asp-for="UserInput.Role"]');
                const sportsSection = document.getElementById('sportsSection');

                roleSelect.addEventListener('change', function() {
                    if (this.value === 'Committee Member') {
                        sportsSection.style.display = 'block';
                    } else {
                        sportsSection.style.display = 'none';
                    }
                });
            });
        </script>
}