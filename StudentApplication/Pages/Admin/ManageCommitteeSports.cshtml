@page
@model StudentApplication.Pages.Admin.ManageCommitteeSportsModel
@{
    ViewData["Title"] = "Manage Committee Member Sports";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["ErrorMessage"]
    </div>
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Assigned Sports</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.CommitteeMembers)
                    {
                        <tr>
                            <td>@member.Name</td>
                            <td>@member.Email</td>
                            <td>
                                @string.Join(", ", member.AvailableSports
                                         .Where(s => member.AssignedSportIds.Contains(s.SportID))
                                         .Select(s => s.SportName))
                            </td>
                            <td>
                                <form method="post" class="form-inline">
                                    <input type="hidden" name="SelectedUserId" value="@member.UserId" />
                                    <div class="form-group">
                                        @if (member.AvailableSports != null && member.AvailableSports.Any())
                                        {
                                            <select name="SelectedSports" multiple class="form-control" style="min-width: 200px;">
                                                @foreach (var sport in member.AvailableSports.OrderBy(s => s.SportName))
                                                {
                                                    <option value="@sport.SportID" selected="@(member.AssignedSportIds.Contains(sport.SportID) ? "selected" : null)">
                                                        @sport.SportName
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <p class="text-warning">No sports available</p>
                                        }
                                    </div>
                                    <button type="submit" class="btn btn-primary ml-2">Update Sports</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="row">
        <div class="col-12 text-right">
            <form method="post" asp-page-handler="InitializeIdentitySports">
                <button type="submit" class="btn btn-primary">Initialize IdentitySports</button>
            </form>
            <a asp-page="/Admin/ViewApplicantsByCommitteeSport" class="btn btn-primary">View Applicants by Committee Sport</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('select[multiple]').select2({
                placeholder: "Select sports",
                allowClear: true
            });
        });
    </script>
}