@page
@model StudentApplication.Pages.Admin.ViewApplicantsByCommitteeSportModel
@{
    ViewData["Title"] = "View Applicants by Committee Sport";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["ErrorMessage"]
    </div>
}

<div class="container">
    <div class="row">
        <div class="col-12">
            @if (Model.Applicants != null && Model.Applicants.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Date of Birth</th>
                            <th>Sporting Details</th>
                            <th>Referees</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var applicant in Model.Applicants)
                        {
                            <tr>
                                <td>@applicant.Name</td>
                                <td>@applicant.DateOfBirth?.ToString("yyyy-MM-dd")</td>
                                <td>@applicant.SportingDetails</td>
                                <td>
                                    <ul>
                                        @foreach (var referee in applicant.Referees)
                                        {
                                            <li>
                                                <strong>@referee.Name</strong> (@referee.TitleOrRole)<br>
                                                Phone: @referee.PhoneNumber<br>
                                                Email: @referee.Email
                                            </li>
                                        }
                                    </ul>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No applicants found for your assigned sports.</p>
            }
        </div>
    </div>
</div>