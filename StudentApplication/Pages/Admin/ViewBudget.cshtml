@page
@model StudentApplication.Pages.Admin.ViewBudgetModel
@{
    ViewData["Title"] = "View Budget";
}

<h1>Budget Overview</h1>

<!-- Year selection buttons -->
<div class="mb-4">
    @{
        var currentYear = DateTime.UtcNow.Year;
        for (int i = currentYear; i >= currentYear - 5; i--)
        {
            <a href="?year=@i" class="btn @(Model.SelectedYear == i.ToString() ? "btn-primary" : "btn-secondary")">@i</a>
        }
    }
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Budget Details for @Model.SelectedYear</h5>
        <p class="card-text">
            <strong>Budget Year:</strong> @Model.Budget.BudgetYear<br />
            <strong>Total Budget:</strong> @Model.Budget.BudgetAmount.ToString("C")<br />
            <strong>Total Scholarship Amount:</strong> @Model.TotalScholarshipAmount.ToString("C")<br />
            <strong>Remaining Budget:</strong> @Model.RemainingBudget.ToString("C")<br />
        </p>
    </div>
</div>

<h3 class="mt-4">Budget Usage by College Year</h3>

<table class="table">
    <thead>
        <tr>
            <th>College Year</th>
            <th>Budget Used</th>
        </tr>
    </thead>
    <tbody>
        <tr onclick="toggleApplicants('firstYearApplicants')" style="cursor: pointer;">
            <td>First Year</td>
            <td>@Model.Budget.BudgetForFirstYears.ToString("C")</td>
            
        </tr>
        <tr onclick="toggleApplicants('secondYearApplicants')" style="cursor: pointer;">
            <td>Second Year</td>
            <td>@Model.Budget.BudgetForSecondYears.ToString("C")</td>
        </tr>
        <tr onclick="toggleApplicants('thirdYearApplicants')" style="cursor: pointer;">
            <td>Third Year</td>
            <td>@Model.Budget.BudgetForThirdYears.ToString("C")</td>
        </tr>
        <tr onclick="toggleApplicants('fourthYearApplicants')" style="cursor: pointer;">
            <td>Fourth Year</td>
            <td>@Model.Budget.BudgetForFourthYears.ToString("C")</td>
        </tr>
    </tbody>
</table>

<!-- Previous year's fourth-year scholarships -->
<h3 class="mt-4">Previous Year's Fourth Year Scholarships</h3>
<div class="card">
    <div class="card-body">
        <p class="card-text">
            <strong>Total Fourth Year Scholarships (Previous Year):</strong> @Model.PreviousYearFourthYearScholarships.ToString("C")<br />
        </p>
    </div>
</div>

<!-- Applicants for each year -->
<h3 class="mt-4">Applicants by College Year</h3>

<div id="firstYearApplicants" style="display: none;">
    <h4>First Year Applicants</h4>
    @if (Model.FirstYearApplicants.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Scholarship Type</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var applicant in Model.FirstYearApplicants)
                {
                    var scholarshipOffer = Model.ScholarshipOffers
                    .FirstOrDefault(h => h.ApplicantID == applicant.ApplicantID);
                    <tr>
                        <td>@applicant.FirstName @applicant.LastName</td>
                        <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.ScholarshipLevelName</td>
                        <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.PaymentAmount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No first-year applicants found.</p>
    }
</div>

<div id="secondYearApplicants" style="display: none;">
    <h4>Second Year Applicants</h4>
    @if (Model.SecondYearApplicants.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
