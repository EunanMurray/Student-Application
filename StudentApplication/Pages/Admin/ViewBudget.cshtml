@page
@model StudentApplication.Pages.Admin.ViewBudgetModel
@{
    ViewData["Title"] = "View Budget";
}

<div class="container py-3">
    <h1>Budget Overview</h1>

    <!-- Year selection buttons -->
    <div class="mb-4">
        <h5>Select Financial Year:</h5>
        <div class="btn-group">
            @{
                var currentYear = DateTime.UtcNow.Year;
                for (int i = currentYear; i >= currentYear - 5; i--)
                {
                    <a href="?year=@i" class="btn @(Model.SelectedYear == i.ToString() ? "btn-primary" : "btn-outline-secondary")">@i</a>
                }
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Budget Details for @Model.SelectedYear</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Budget Year:</strong> @Model.Budget.BudgetYear</p>
                    <p><strong>Total Budget:</strong> @Model.Budget.BudgetAmount.ToString("C")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Total Scholarship Amount:</strong> @Model.TotalScholarshipAmount.ToString("C")</p>
                    <p><strong>Remaining Budget:</strong> <span class="@(Model.RemainingBudget < 0 ? "text-danger" : "")">@Model.RemainingBudget.ToString("C")</span></p>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mt-4">Budget Usage by College Year</h3>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>College Year</th>
                    <th>Budget Used</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                <tr onclick="toggleApplicants('firstYearApplicants')" style="cursor: pointer;">
                    <td>First Year</td>
                    <td>@Model.Budget.BudgetForFirstYears.ToString("C")</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary">View</button>
                    </td>
                </tr>
                <tr onclick="toggleApplicants('secondYearApplicants')" style="cursor: pointer;">
                    <td>Second Year</td>
                    <td>@Model.Budget.BudgetForSecondYears.ToString("C")</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary">View</button>
                    </td>
                </tr>
                <tr onclick="toggleApplicants('thirdYearApplicants')" style="cursor: pointer;">
                    <td>Third Year</td>
                    <td>@Model.Budget.BudgetForThirdYears.ToString("C")</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary">View</button>
                    </td>
                </tr>
                <tr onclick="toggleApplicants('fourthYearApplicants')" style="cursor: pointer;">
                    <td>Fourth Year</td>
                    <td>@Model.Budget.BudgetForFourthYears.ToString("C")</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary">View</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="card mt-4 mb-4">
        <div class="card-header">
            <h5 class="mb-0">Previous Year's Fourth Year Scholarships</h5>
        </div>
        <div class="card-body">
            <p><strong>Total Fourth Year Scholarships (Previous Year):</strong> @Model.PreviousYearFourthYearScholarships.ToString("C")</p>
        </div>
    </div>

    <h3 class="mt-4">Applicants by College Year</h3>

    <div id="firstYearApplicants" style="display: none;">
        <h4>First Year Applicants</h4>
        @if (Model.FirstYearApplicants.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Scholarship Type</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var applicant in Model.FirstYearApplicants)
                        {
                            var scholarshipOffer = Model.ScholarshipOffers
                            .FirstOrDefault(h => h.ApplicantID == applicant.ApplicantID);
                            <tr>
                                <td>@applicant.FirstName @applicant.LastName</td>
                                <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.ScholarshipLevelName</td>
                                <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.PaymentAmount.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>No first-year applicants found.</p>
        }
    </div>

    <div id="secondYearApplicants" style="display: none;">
        <h4>Second Year Applicants</h4>
        @if (Model.SecondYearApplicants.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Scholarship Type</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var applicant in Model.SecondYearApplicants)
                        {
                            var scholarshipOffer = Model.ScholarshipOffers
                            .FirstOrDefault(h => h.ApplicantID == applicant.ApplicantID);
                            <tr>
                                <td>@applicant.FirstName @applicant.LastName</td>
                                <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.ScholarshipLevelName</td>
                                <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.PaymentAmount.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>No second-year applicants found.</p>
        }
    </div>

    <div id="thirdYearApplicants" style="display: none;">
        <h4>Third Year Applicants</h4>
        @if (Model.ThirdYearApplicants.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Scholarship Type</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var applicant in Model.ThirdYearApplicants)
                        {
                            var scholarshipOffer = Model.ScholarshipOffers
                            .FirstOrDefault(h => h.ApplicantID == applicant.ApplicantID);
                            <tr>
                                <td>@applicant.FirstName @applicant.LastName</td>
                                <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.ScholarshipLevelName</td>
                                <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.PaymentAmount.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>No third-year applicants found.</p>
        }
    </div>

    <div id="fourthYearApplicants" style="display: none;">
        <h4>Fourth Year Applicants</h4>
        @if (Model.FourthYearApplicants.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Scholarship Type</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var applicant in Model.FourthYearApplicants)
                        {
                            var scholarshipOffer = Model.ScholarshipOffers
                            .FirstOrDefault(h => h.ApplicantID == applicant.ApplicantID);
                            <tr>
                                <td>@applicant.FirstName @applicant.LastName</td>
                                <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.ScholarshipLevelName</td>
                                <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.PaymentAmount.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>No fourth-year applicants found.</p>
        }
    </div>
</div>

<style>
    .table-responsive {
        margin-bottom: 20px;
    }
</style>

<script>
    function toggleApplicants(tableId) {
        var table = document.getElementById(tableId);
        if (table.style.display === "none") {
            table.style.display = "block";
        } else {
            table.style.display = "none";
        }
    }
</script>