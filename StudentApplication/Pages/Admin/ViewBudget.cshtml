                        <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.ScholarshipLevelName</td>
                        <td>@scholarshipOffer?.Scholarship?.ScholarshipType?.PaymentAmount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No second-year applicants found.</p>
    }
</div>

<div id="thirdYearApplicants" style="display: none;">
    <h4>Third Year Applicants</h4>
    @if (Model.ThirdYearApplicants.Any())
    {
        <table class="table">
            <thead>
