@model StudentApplicationPages.ViewModels.ApplicantViewModel

<div>
    <h3>Review Your Application</h3>
    <h4>Personal Details</h4>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <!-- Add other personal details -->

    <h4>Academic History</h4>
    <p><strong>CAO Number:</strong> @Model.CAONumber</p>
    <p><strong>Campus:</strong> @(Model.CampusID == 1 ? "Sligo" : Model.CampusID == 2 ? "Galway" : "Letterkenny")</p>
    <!-- Add other academic details -->

    <h4>Sport Details</h4>
    <p><strong>Main Sports:</strong> @string.Join(", ", Model.SportIDs)</p>
    <!-- Add other sport details -->

    <h4>References</h4>
    @for (int i = 0; i < Model.Referees.Count; i++)
    {
        <p><strong>Referee @(i + 1) Name:</strong> @Model.Referees[i].Name</p>
        <!-- Add other referee details -->
    }

    <h4>Declaration</h4>
    <p><strong>Preferred Leisurewear Size:</strong> @Model.PreferredLeisurewearSize</p>
    <p><strong>Declaration Confirmed:</strong> @(Model.IsDeclarationConfirmed ? "Yes" : "No")</p>
</div>
